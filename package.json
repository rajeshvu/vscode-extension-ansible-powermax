{
  "name": "ansible-powermax-snippets",
  "displayName": "PowerMax Ansible Snippets",
  "description": "Search and insert Dell EMC PowerMax Ansible snippets inside VSCode",
  "version": "4.0.2",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "logo.png",
  "keywords": [
    "powermax",
    "ansible",
    "snippets",
    "dell",
    "emc",
    "storage",
    "automation"
  ],
  "license": "MIT",
  "licenseText": "MIT License\n\nCopyright (c) 2023 Rajesh V U",
  "publisher": "rajeshvu",
  "repository": {
    "type": "git",
    "url": "https://github.com/rajeshvu/vscode-extension-ansible-powermax.git"
  },
  "activationEvents": [
      "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ansible-powermax-snippets.search-4.0.2",
        "title": "PowerMax Ansible Snippets - v4.0.2"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  }
}
